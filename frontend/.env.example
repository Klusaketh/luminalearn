# Copy to .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_THEME=dark
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Where the Next.js server forwards /api/v1 requests and the voice WebSocket. Server-only:
# the browser always calls this site's /api/v1, so it never needs the backend's address.
# Must match BACKEND_PORT in the root .env.
BACKEND_URL=http://127.0.0.1:8001
