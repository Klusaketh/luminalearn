# ==============================================================================
# LUMINALEARN AI — CENTRALIZED ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development. Never commit real credentials!

# ------------------------------------------------------------------------------
# PROJECT METADATA & ENVIRONMENT SPECIFICATION
# ------------------------------------------------------------------------------
PROJECT_NAME="LuminaLearn AI"
PROJECT_CODENAME="Project Aurora"
ENVIRONMENT="development"  # development | testing | staging | production
DEBUG=true
LOG_LEVEL="DEBUG"            # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (NEXT.JS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_DEFAULT_THEME="system" # light | dark | system

# ------------------------------------------------------------------------------
# BACKEND FASTAPI CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SUPER_SECRET_KEY_MIN_32_BYTES"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (POSTGRESQL 16)
# ------------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="lumina_admin"
POSTGRES_PASSWORD="lumina_dev_password_2026"
POSTGRES_DB="luminalearn_db"
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_SSL_MODE="prefer"

# Construct Async SQLAlchemy URI in code using above parameters:
# postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# IN-MEMORY CACHE & EVENT BROKER (REDIS 7)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# VECTOR DATABASE CONFIGURATION (QDRANT)
# ------------------------------------------------------------------------------
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_KNOWLEDGE="knowledge_graph_embeddings"

# ------------------------------------------------------------------------------
# AI ENGINE CONFIGURATION (GOOGLE GEMINI 1.5)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL_PRO="gemini-1.5-pro"
GEMINI_MODEL_FLASH="gemini-1.5-flash"
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2048
GEMINI_DATA_POLICY_ZERO_RETENTION=true

# ------------------------------------------------------------------------------
# UNIVERSAL ACCESSIBILITY & TELEMETRY FLAGS
# ------------------------------------------------------------------------------
ENABLE_WCAG_AAA_STRICT_MODE=true
ENABLE_SOCRATIC_SAFETY_GUARDRAILS=true
